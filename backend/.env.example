# Optional: enable only in an isolated CI runner; the MVP never executes uploaded tests by default.
CLANKER_ENABLE_TEST_EXECUTION=false

# Optional OpenAI-compatible analyst provider. Leave blank for deterministic local analysis.
CLANKER_AI_API_KEY=
CLANKER_AI_BASE_URL=https://api.openai.com/v1
CLANKER_AI_MODEL=gpt-4o-mini
